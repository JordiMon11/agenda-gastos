{
  "name": "agenda-gastos",
  "version": "1.0.0",
  "private": true,
  "description": "Agenda de gastos: web, móvil (PWA) y escritorio, con categorías, calendario, gráficos, resúmenes semanales y avisos por correo",
  "scripts": {
    "start": "node server/index.js",
    "desktop": "npm --prefix desktop start",
    "desktop:build": "npm --prefix desktop run dist",
    "icons": "node scripts/build-icons.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "chart.js": "^4.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "lucide": "^1.79.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}

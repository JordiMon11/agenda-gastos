# Copia este archivo como .env para usarlo en local.
# En Render estas variables se ponen en la pestaña "Environment" del servicio.

PORT=3000

# --- Base de datos (online) ---
# Cadena de conexión de Neon (https://neon.tech, gratis). Sin ella se usa data/db.json.
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Correo: opción recomendada, Brevo (https://brevo.com, gratis, 300 correos/día) ---
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM_EMAIL=tu_correo@gmail.com     (debe estar verificado en Brevo como remitente)
# MAIL_FROM_NAME=Agenda de Gastos

# --- Correo: alternativa SMTP (solo en local; Render gratis bloquea SMTP) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=contraseña_de_aplicación
# MAIL_FROM="Agenda de Gastos <tu_correo@gmail.com>"

# --- Descargas que se muestran en la web ---
# DESKTOP_DOWNLOAD_URL=https://github.com/USUARIO/agenda-gastos/releases/latest/download/Agenda-Gastos-Setup.exe
# RELEASES_URL=https://github.com/USUARIO/agenda-gastos/releases/latest

# --- Entorno ---
# APP_ENV=pruebas   (muestra el aviso «Entorno de PRUEBAS» en la web; en producción no se pone)

# --- IA opcional (de pago). Sin clave, el escáner y el asistente funcionan gratis ---
# ANTHROPIC_API_KEY=sk-ant-...
# RECEIPT_MODEL=claude-opus-5-5     (modelo para leer tickets)
# IMPORT_MAX_MB=10     (tamaño máximo de los extractos bancarios)
# ASSISTANT_MODEL=claude-opus-5-5   (modelo para preguntas que el asistente no entiende)

# Conexión con bancos (Open Banking, solo lectura) con Enable Banking (gratis para uso personal):
# ENABLEBANKING_APP_ID=identificador-de-tu-aplicacion
# ENABLEBANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
# PUBLIC_URL=https://agenda-gastos.onrender.com   (para la vuelta desde el banco)
# OPENBANKING_PROVIDER=demo   (activa el banco de demostración; en la web de pruebas ya está activo)
# CLASSIFY_MODEL=claude-opus-5-5   (IA opcional para clasificar descripciones desconocidas)
